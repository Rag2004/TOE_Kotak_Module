# Kotak Neo UAT only. Do not set NEO_ENVIRONMENT=prod.
NEO_ENVIRONMENT=uat
# API Dashboard access token. Also accepted as NEO_CONSUMER_KEY.
NEO_ACCESS_TOKEN=
NEO_MOBILE_NUMBER=
# Client code (UCC). Also accepted as NEO_UCC.
NEO_CLIENT_ID=
NEO_MPIN=
# Live 6-digit code, or a base32 secret for unattended refresh. Never commit either.
NEO_TOTP=
NEO_TOTP_SECRET=

REDIS_URL=redis://localhost:6379/0
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=quant_db
TOE_KOTAK_PORT=8005
TOE_KOTAK_SKIP_MARGIN_CHECK=false
KOTAK_MODIFY_ENABLED=false
# In-place chase. Set false to wait once for FEED_WAIT_SEC (default 8s) instead.
KOTAK_CHASE_ENABLED=true
KOTAK_CHASE_POLL_SEC=1
KOTAK_CHASE_MODIFY_SEC=3
KOTAK_ENTRY_CHASE_TICKS=1
KOTAK_ENTRY_MAX_SLIP_PCT=0.10
KOTAK_ENTRY_CHASE_MAX_SEC=60
KOTAK_EXIT_CHASE_TICKS=1
KOTAK_EXIT_MAX_MODIFY_ATTEMPTS=20
KOTAK_LTP_REFRESH_ENABLED=true
